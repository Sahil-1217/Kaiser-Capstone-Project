# Kaiser Permanente Cloud Database Credentials Configuration (.env)
# Provide EITHER a unified connection string OR discrete connection parameters

# Option 1: Unified Neon / Cloud PostgreSQL Connection String (Recommended)
# Example: postgresql+psycopg2://<user>:<password>@<ep-xyz>.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Option 2: Discrete Parameters
DB_USER=postgres
DB_PASS=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kaiser_analytics
